    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.3.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "transform": {
